{
  "settings": { "url": "https://localhost:53586/route", "timeout_ms": 2000 },
  "hook": {
    "bad_settings": ["not json", "{}", "{\"url\": \"\"}", "{\"url\": 5}", "{\"url\": \"http://169.254.169.254/\"}"],
    "order_cap": 2,
    "requests": [
      {
        "label": "decide: the far end's order, longer than the first buffer",
        "op": "decide",
        "candidates": [
          { "idx": 3, "cost_per_mtok": 5.0, "available_concurrency": 2 },
          { "idx": 9, "cost_per_mtok": 2.0, "available_concurrency": 1 },
          { "idx": 7, "latency_ms": 90.0, "available_concurrency": 4 }
        ],
        "expect": { "verb": "prefer", "order": [9, 3, 7] }
      },
      {
        "label": "transform: the far end names no rewrite",
        "op": "transform",
        "candidates": [],
        "expect": { "verb": "abstain" }
      }
    ],
    "refresh": {
      "settings": { "url": "https://localhost:53586/refreshed", "timeout_ms": 2000 },
      "request": {
        "label": "decide: the refreshed target's order",
        "op": "decide",
        "candidates": [
          { "idx": 9, "cost_per_mtok": 2.0, "available_concurrency": 1 },
          { "idx": 7, "latency_ms": 90.0, "available_concurrency": 4 }
        ],
        "expect": { "verb": "prefer", "order": [7, 9] }
      }
    }
  }
}
